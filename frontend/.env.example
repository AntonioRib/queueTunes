# Frontend env vars (Vite reads all `VITE_*` from `.env`, `.env.local`, etc).
# Copy this file to `.env.local` for local dev and fill in real values.

# Spotify OAuth app client id (Spotify Developer Dashboard → your app).
VITE_SPOTIFY_CLIENT_ID=

# Redirect URI registered on the Spotify Developer Dashboard.
# Must match the origin `npm start` serves on: http://127.0.0.1:3000
VITE_SPOTIFY_REDIRECT_URL=http://127.0.0.1:3000

# Spotify Accounts authorize endpoint.
VITE_SPOTIFY_AUTH_URL=https://accounts.spotify.com/authorize

# Base URL of the QueueTunes Express backend (see backend/.env for how to run it).
VITE_BACKEND_URL=http://127.0.0.1:5333
